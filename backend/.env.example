# Copy to .env and fill in. Never commit .env — it holds the database password.

# Supabase Postgres, via the session pooler (Settings -> Database -> Connection
# Pooling for the region and exact host). Password must be URL-encoded
# (e.g. "!" -> "%21"). Username is "postgres.<project-ref>", not "postgres".
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_BUCKET=dress-photos

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
