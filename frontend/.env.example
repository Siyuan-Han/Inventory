# Local dev: your uvicorn backend, with /api since routes live under that
# prefix. Leave unset in production (Vercel) — requests default to the
# same-origin relative "/api", which the vercel.json rewrite forwards to
# the backend service.
VITE_API_BASE_URL=http://localhost:8001/api

# Used to upload dress photos straight to Supabase Storage from the browser.
# The anon key is meant to be public; the dress-photos bucket's RLS policies
# scope what it can touch.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_SUPABASE_BUCKET=dress-photos
